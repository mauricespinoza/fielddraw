# Archivos que genera el sincronizador de Google Drive y el sistema.
desktop.ini
Thumbs.db
.DS_Store

# Nada de node_modules: el proyecto no usa npm a propósito (ver README).
node_modules/

# Proyectos y exportaciones de prueba: son datos, no código.
*.gpkg
*.mbtiles
*.pmtiles
*.fdproj.json

# Caché de Python. El ZIP del complemento sí va versionado: es lo que se
# descarga para instalarlo, y `tools/package.py` lo reconstruye idéntico.
__pycache__/
*.py[co]
